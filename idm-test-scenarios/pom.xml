<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.idm.test</groupId>
        <artifactId>idm-test-framework</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>idm-test-scenarios</artifactId>
    <name>IdM Test Scenarios</name>
    <description>Integration test scenarios for IdM provisioning workflows</description>

    <dependencies>
        <!-- All connectors -->
        <dependency>
            <groupId>com.idm.test</groupId>
            <artifactId>idm-test-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.idm.test</groupId>
            <artifactId>idm-test-utils</artifactId>
        </dependency>

        <dependency>
            <groupId>com.idm.test</groupId>
            <artifactId>idm-test-engine</artifactId>
        </dependency>

        <dependency>
            <groupId>com.idm.test</groupId>
            <artifactId>idm-connector-ldap</artifactId>
        </dependency>

        <dependency>
            <groupId>com.idm.test</groupId>
            <artifactId>idm-connector-database</artifactId>
        </dependency>

        <dependency>
            <groupId>com.idm.test</groupId>
            <artifactId>idm-connector-rest</artifactId>
        </dependency>

        <dependency>
            <groupId>com.idm.test</groupId>
            <artifactId>idm-connector-soap</artifactId>
        </dependency>

        <dependency>
            <groupId>com.idm.test</groupId>
            <artifactId>idm-connector-idm</artifactId>
        </dependency>

        <!-- Spring Boot Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
        </dependency>

        <!-- Boot 4 split auto-configuration into modules; the tests exclude LdapAutoConfiguration,
             which now lives here (DataSourceAutoConfiguration comes with the JDBC starter). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-ldap</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- AssertJ -->
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>

        <!-- H2 Database for testing -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- WireMock for SOAP mocking -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ContainerScenarios: real OpenLDAP, PostgreSQL and WireMock containers (ITF-14).
             Only that runner starts them; the default build never touches Docker. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JDBC drivers. idm-connector-database declares these optional, so they are not
             inherited. RealEnvironmentScenarios and ContainerScenarios need them to reach a
             real PostgreSQL or Oracle database. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
