<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.idm.test</groupId>
    <artifactId>idm-test-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IdM Test Framework</name>
    <description>Integration Testing Framework for Identity Management Systems</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency Versions -->
        <spring-boot.version>3.5.6</spring-boot.version>
        <spring-ldap.version>3.2.9</spring-ldap.version>
        <unboundid-ldapsdk.version>7.0.1</unboundid-ldapsdk.version>
        <assertj.version>3.26.3</assertj.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <wiremock.version>3.10.0</wiremock.version>
        <commons-lang3.version>3.17.0</commons-lang3.version>
        <h2.version>2.3.232</h2.version>
        <rhino.version>1.8.0</rhino.version>
        <postgresql.version>42.7.4</postgresql.version>
        <oracle.version>23.6.0.24.10</oracle.version>
        <apacheds.version>2.0.0.AM27</apacheds.version>
    </properties>

    <modules>
        <module>idm-test-core</module>
        <module>idm-test-utils</module>
        <module>idm-test-engine</module>
        <module>idm-connector-ldap</module>
        <module>idm-connector-database</module>
        <module>idm-connector-rest</module>
        <module>idm-connector-soap</module>
        <module>idm-connector-idm</module>
        <module>idm-test-scenarios</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Modules -->
            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-test-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-test-utils</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-test-engine</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-ldap</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-database</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-rest</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-soap</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-idm</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Spring LDAP -->
            <dependency>
                <groupId>org.springframework.ldap</groupId>
                <artifactId>spring-ldap-core</artifactId>
                <version>${spring-ldap.version}</version>
            </dependency>

            <!-- UnboundID LDAP SDK -->
            <dependency>
                <groupId>com.unboundid</groupId>
                <artifactId>unboundid-ldapsdk</artifactId>
                <version>${unboundid-ldapsdk.version}</version>
            </dependency>

            <!-- Apache Directory Server (for embedded LDAP tests) -->
            <dependency>
                <groupId>org.apache.directory.server</groupId>
                <artifactId>apacheds-all</artifactId>
                <version>${apacheds.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- AssertJ -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
            </dependency>

            <!-- Apache Commons Lang3 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-lang3</artifactId>
                <version>${commons-lang3.version}</version>
            </dependency>

            <!-- Mozilla Rhino - sandboxed expression evaluation in scenarios -->
            <dependency>
                <groupId>org.mozilla</groupId>
                <artifactId>rhino</artifactId>
                <version>${rhino.version}</version>
            </dependency>

            <!-- Testcontainers -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- WireMock -->
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Database Drivers -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>

            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql.version}</version>
            </dependency>

            <dependency>
                <groupId>com.oracle.database.jdbc</groupId>
                <artifactId>ojdbc11</artifactId>
                <version>${oracle.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
