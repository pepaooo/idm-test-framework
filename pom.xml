<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.idm.test</groupId>
    <artifactId>idm-test-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>IdM Test Framework</name>
    <description>Integration Testing Framework for Identity Management Systems</description>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Dependency Versions -->
        <unboundid-ldapsdk.version>7.0.1</unboundid-ldapsdk.version>
        <wiremock.version>3.10.0</wiremock.version>
        <rhino.version>1.8.0</rhino.version>
    </properties>

    <modules>
        <module>idm-test-core</module>
        <module>idm-test-utils</module>
        <module>idm-test-engine</module>
        <module>idm-connector-ldap</module>
        <module>idm-connector-database</module>
        <module>idm-connector-rest</module>
        <module>idm-connector-soap</module>
        <module>idm-connector-idm</module>
        <module>idm-test-wiring</module>
        <module>idm-test-scenarios</module>
        <module>idm-test-runner</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Modules -->
            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-test-core</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-test-utils</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-test-engine</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-ldap</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-database</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-rest</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-soap</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-connector-idm</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-test-wiring</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>com.idm.test</groupId>
                <artifactId>idm-test-runner</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- UnboundID LDAP SDK -->
            <dependency>
                <groupId>com.unboundid</groupId>
                <artifactId>unboundid-ldapsdk</artifactId>
                <version>${unboundid-ldapsdk.version}</version>
            </dependency>

            <!-- Mozilla Rhino - sandboxed expression evaluation in scenarios -->
            <dependency>
                <groupId>org.mozilla</groupId>
                <artifactId>rhino</artifactId>
                <version>${rhino.version}</version>
            </dependency>

            <!-- WireMock -->
            <dependency>
                <groupId>org.wiremock</groupId>
                <artifactId>wiremock-standalone</artifactId>
                <version>${wiremock.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <includes>
                            <include>**/*Test.java</include>
                            <include>**/*Tests.java</include>
                        </includes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
